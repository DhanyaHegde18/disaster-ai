# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# Free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=

# Optional: switch models without touching code (check ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
