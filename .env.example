# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# Free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=

# Optional: switch models without touching code (check ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Automatic scoring while the server runs (set SCHEDULER_ENABLED=false to turn it off)
SCHEDULER_ENABLED=true
SCORING_INTERVAL_MIN=180

# ---- Sign-in codes by SMS ----
# demo     = code shown on screen, no SMS (default)
# twilio   = Twilio Verify. Free trial: sign up at twilio.com, verify up to 5 phone numbers in the console,
#            create a Verify Service (Console > Verify > Services) and copy its SID (starts with VA).
# fast2sms = Fast2SMS OTP route, any Indian number, paid per SMS. API key: fast2sms.com > Dev API.
SMS_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
FAST2SMS_API_KEY=

# Set to true once the site is served over https (keeps the session cookies https-only)
# COOKIE_SECURE=true   (not needed: cookies become https-only by themselves when the page is opened over https)

# ---- Phone alarms when nobody has the dashboard open (ntfy, free) ----
# Install the "ntfy" app (Play Store / F-Droid / App Store) on each staff phone and subscribe to the topic.
# Topic names work like passwords: anyone who knows one can read it, so make them long and random,
# e.g.  python3 -c "import secrets; print('gp-' + secrets.token_hex(8))"
# Leave a topic empty to switch phone alarms off for that role.
# Each person subscribes to their OWN topic, shown on the dashboard after sign-in
# (e.g. <NTFY_TOPIC_GP>-dakshina-kannada-belthangady for a GP in Belthangady taluk).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC_GP=
NTFY_TOPIC_NGO=
# Address staff open when they tap the notification (use your laptop's LAN IP or public URL)
# PUBLIC_URL=https://...   (not needed: the app learns its address from the dashboard; set only to force one)
# Repeat the alarm every N minutes until a GP reviews the alert / marks the rescue handled, at most M times
ESCALATE_AFTER_MIN=15
ESCALATE_MAX_TIMES=8

# ---- Landslide model ----
# How far the model may raise a square on its own (rain rule LOW). MEDIUM = watch only (default);
# HIGH = the model alone can trigger an alert draft (more false alarms).
# LANDSLIDE_MODEL_ALONE_MAX=MEDIUM
